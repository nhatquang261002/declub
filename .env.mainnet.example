# Monad MAINNET (chain id 143) settings, the "mainnet flavor" of the app (README, "Flavors").
# Copy this file to `.env.mainnet` (untracked) and fill it in:
#   local          -> `cd web && npm run dev:mainnet` / `build:mainnet` / `start:mainnet` (port 3001,
#                     build folder web/.next-mainnet) and `cd matcher && npm run start:mainnet`. These
#                     read ONLY this file (plus web/.env.mainnet.local for server secrets); the testnet
#                     .env and web/.env.local are blanked out, so nothing from them leaks in.
#   deploy shell   -> contracts (export before `forge script`)
#   host env       -> web (Vercel etc.) and the matcher: set the same keys in a separate project.
# Never reuse the testnet .env.
# Read docs/11-test-plan.md section 6 first. Every value marked REQUIRED has no safe default.

# ── Deploy (contracts/script/DeployEscrow.s.sol, DeployIntents.s.sol, DeployRewards.s.sol) ───────
# The scripts refuse a mainnet deploy that has mocks, a missing/shared Safe, FEE_FIXED, or any
# FEE_TOKEN other than the canonical WMON below.
# $5 per side in MON wei at the recorded MON price: round(5 / price * 1e18). REQUIRED.
PROTOCOL_FEE_WEI=
# About 4x the fee. Immutable once deployed. REQUIRED.
PROTOCOL_FEE_MAX_WEI=
# Safe that receives the fees; must be able to receive MON and WMON. Immutable. REQUIRED.
FEE_RECIPIENT=
# A DIFFERENT Safe that may change the fee. REQUIRED.
FEE_ADMIN=
# Canonical WMON on Monad mainnet (docs.monad.xyz network information). Immutable.
FEE_TOKEN=0x3bd359C1119dA7Da1D913D1C4D2B7c461115433A
# contracts/script/DeployRewards.s.sol: the Safe that publishes and funds reward epochs (it refuses
# an EOA on mainnet), and a claim delay of at least a day. REQUIRED.
REWARDS_OPERATOR=
REWARDS_CLAIM_DELAY=86400
REWARDS_CLAIM_WINDOW=7776000

# ── Web (build-time NEXT_PUBLIC_*; set them in the host, not in a checked-in file) ───────────
NEXT_PUBLIC_CHAIN_ID=143
# A dedicated provider key is better than the public RPC for production traffic. REQUIRED.
NEXT_PUBLIC_RPC_URL=https://rpc.monad.xyz
# The real Chog collection. REQUIRED (the app throws on mainnet without it).
NEXT_PUBLIC_CHOG_ADDRESS=
# From the deploy output.
NEXT_PUBLIC_DECLUB_ESCROW_ADDRESS=
NEXT_PUBLIC_DECLUB_INTENTS_ADDRESS=
NEXT_PUBLIC_DECLUB_REWARDS_ADDRESS=
# Weekly epochs from the launch week's Monday, 00:00 UTC (unix seconds). REQUIRED.
NEXT_PUBLIC_REWARDS_GENESIS=
# The mainnet matcher listens on 8788 so it can run beside the testnet one (8787). This is inlined into
# the browser bundle, so it is for the local flavor only: for a hosted deploy set the matcher's public HTTPS URL.
NEXT_PUBLIC_POOL_URL=http://127.0.0.1:8788
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_KNOWN_COLLECTIONS=
# Optional: where the app is served, for the absolute links in share cards (og:image). Blank on a
# self-hosted build = http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=
# Optional: path gateway for ipfs:// token URIs, ending in /ipfs/. Blank = https://ipfs.io/ipfs/.
# NEXT_PUBLIC_IPFS_GATEWAY=
# Optional: true creates an embedded wallet at social sign-in. Blank = wallet-first.
# NEXT_PUBLIC_PRIVY_EMBEDDED_WALLETS=
NEXT_PUBLIC_CHOG_MINTABLE=false
# Leave NEXT_PUBLIC_MOCK_ERC20_ADDRESS out entirely, and NEXT_PUBLIC_REWARDS_EPOCH_SECONDS (a week).
# Never set REWARDS_OPERATOR_KEY on mainnet: epochs are published from the Safe.

# ── Web server values (host environment only) ────────────────────────────────────────────────
PRIVY_APP_SECRET=
PRIVY_WEBHOOK_SIGNING_SECRET=
# A production Upstash database, separate from testnet.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
# The mainnet DeClubEscrow deploy block.
FILL_WATCHER_START_BLOCK=
CLUB_ADMIN_USER_IDS=
# Optional: Moralis key for on-chain asset search in Create Deal (Monad mainnet only). Without it the
# search falls back to the verified and featured assets.
# MORALIS_API_KEY=
# Optional: X API bearer token for the Holder bonus's reach read (pay per use). Without it X posts
# count by number only.
# X_BEARER_TOKEN=

# ── Matcher ──────────────────────────────────────────────────────────────────────────────────
# A NEW key used only here, funded with a little MON for gas. It holds no one's assets.
MATCHER_PRIVATE_KEY=
MATCHER_RPC_URL=
# Comma-separated token addresses the matcher will settle. REQUIRED on mainnet.
MATCHER_TOKEN_ALLOWLIST=
# true only when it sits behind a reverse proxy that sets X-Forwarded-For.
MATCHER_TRUST_PROXY=
MATCHER_HOST=127.0.0.1
MATCHER_PORT=8788
# Put the sqlite file on persistent storage, and never share the testnet matcher's file.
MATCHER_DB_PATH=

# ── Post-deploy check: cd e2e && npm run verify -- --mainnet ─────────────────────────────────
VERIFY_RPC_URL=https://rpc.monad.xyz
EXPECT_CHAIN_ID=143
EXPECT_FEE_TOKEN=0x3bd359C1119dA7Da1D913D1C4D2B7c461115433A
EXPECT_FEE_WEI=
EXPECT_MAX_FEE_WEI=
EXPECT_FEE_RECIPIENT=
EXPECT_FEE_ADMIN=
