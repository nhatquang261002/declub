{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:testnet": "node scripts/flavor.mjs testnet next dev -p 3000",
    "dev:mainnet": "node scripts/flavor.mjs mainnet next dev -p 3001",
    "build:testnet": "node scripts/flavor.mjs testnet next build",
    "build:mainnet": "node scripts/flavor.mjs mainnet next build",
    "start:testnet": "node scripts/flavor.mjs testnet next start -p 3000",
    "start:mainnet": "node scripts/flavor.mjs mainnet next start -p 3001",
    "rewards:epoch:mainnet": "node scripts/flavor.mjs mainnet npm run rewards:epoch --",
    "rewards:sponsor:mainnet": "node scripts/flavor.mjs mainnet npm run rewards:sponsor --",
    "rewards:verify:mainnet": "node scripts/flavor.mjs mainnet npm run rewards:verify --",
    "store:backup:mainnet": "node scripts/flavor.mjs mainnet npm run store:backup --",
    "rewards:backup:mainnet": "node scripts/flavor.mjs mainnet npm run rewards:backup --",
    "members:backup:mainnet": "node scripts/flavor.mjs mainnet npm run members:backup --",
    "lint": "eslint",
    "abi": "wagmi generate",
    "rewards:epoch": "node --import ./test/register.mjs scripts/rewards-epoch.ts",
    "rewards:sponsor": "node --import ./test/register.mjs scripts/rewards-sponsor.ts",
    "rewards:verify": "node --import ./test/register.mjs scripts/rewards-verify.ts",
    "store:backup": "node --import ./test/register.mjs scripts/store-backup.ts",
    "rewards:backup": "node --import ./test/register.mjs scripts/rewards-backup.ts",
    "members:backup": "node --import ./test/register.mjs scripts/memberships.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/register.mjs --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "format": "prettier --write \"**/*.{ts,tsx,mjs}\" \"../matcher/**/*.ts\" \"../e2e/**/*.ts\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs}\" \"../matcher/**/*.ts\" \"../e2e/**/*.ts\""
  },
  "dependencies": {
    "@envio-dev/hypersync-client": "^1.4.1",
    "@next/env": "^16.3.6",
    "@privy-io/node": "^0.35.0",
    "@privy-io/react-auth": "^3.46.0",
    "@privy-io/wagmi": "^4.0.17",
    "@stripe/stripe-js": "^1.54.2",
    "@tanstack/react-query": "^5.104.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svix": "^1.99.1",
    "viem": "2.56.0",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wagmi/cli": "^2.10.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
