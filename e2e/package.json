{
  "name": "e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pre-mainnet end-to-end checks: chain scenarios, deployment verification, web smoke tests",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/run.ts --target local",
    "testnet": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/run.ts --target testnet",
    "verify": "node src/verify.ts",
    "web": "node src/web-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5"
  }
}
