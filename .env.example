# ── Contracts (Foundry) ──────────────────────────────────────────────
# Monad testnet (chain id 10143). RPC alias `monad_testnet` is set in contracts/foundry.toml.
# Deployer: prefer an encrypted keystore (`cast wallet import deployer --interactive`)
# over a raw key. Never commit a real key.

# DeployV2.s.sol: also deploy a mock ERC-20 (mUSD) and mint DEMO_MINT_AMOUNT of it to DEMO_WALLETS.
DEPLOY_MOCK_ERC20=false
DEMO_MINT_AMOUNT=1000

# Protocol fee (docs/adr/0015-protocol-fee.md), fixed at deploy and read by the app from the contract.
# PROTOCOL_FEE_WEI is the per-side fee in wei of MON (0 = no fee; at most 500 MON). It is MON in
# OnDealV2 (DeployV2) and WMON, the same amount, in OnDealIntents (DeployIntents). FEE_RECIPIENT
# receives it and is required when the fee is not 0: a Safe or another wallet that can receive MON
# and WMON. FEE_TOKEN is the chain's wrapped MON (DeployIntents only); DEPLOY_MOCK_WMON=true deploys
# a test WMON instead, for testnet, which has no canonical one.
PROTOCOL_FEE_WEI=0
FEE_RECIPIENT=
FEE_TOKEN=
DEPLOY_MOCK_WMON=false

# Chog collection. Blank = the deploy script deploys MockChog.
CHOG_ADDRESS=
# MockChog only: comma-separated wallets to mint demo Chogs to, and how many each.
DEMO_WALLETS=
DEMO_MINT_PER_WALLET=5
DEPLOY_CHOG_MIRROR=false
MIRROR_CATALOG_OWNER=
MIRROR_MINT_BATCH=20

# ── Web (Next.js) ────────────────────────────────────────────────────
# web/next.config.ts loads this root .env. Blank values fall back to the Phase 1
# testnet deployment (web/lib/config.ts).
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHOG_ADDRESS=
NEXT_PUBLIC_ON_DEAL_ADDRESS=
# Block the OnDeal contract was deployed at. Unused by the app for now (ADR 0004);
# kept as the start block for a future indexer.
NEXT_PUBLIC_ON_DEAL_DEPLOY_BLOCK=
# OnDealV2 (generic multi-asset escrow, Phase 4). Blank = V2 features are off.
NEXT_PUBLIC_ON_DEAL_V2_ADDRESS=
# Test ERC-20 with an open mint (deploy with DEPLOY_MOCK_ERC20=true). Optional.
NEXT_PUBLIC_MOCK_ERC20_ADDRESS=
# MockChog has an open mint and the app shows a "mint test Chogs" panel.
# Set to false when pointing at the real Chog collection.
NEXT_PUBLIC_CHOG_MINTABLE=true
# Optional. NFT collections the picker lists first, besides the Chog one (comma-separated addresses).
NEXT_PUBLIC_KNOWN_COLLECTIONS=
# Privy app id (dashboard.privy.io): Google / X / Discord sign-in, embedded wallets and
# linked accounts. Blank = the plain injected-wallet connect. Allow-list your origin in the dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
# true = social sign-in also creates an embedded wallet. Needs embedded wallets enabled in the Privy
# dashboard. Blank/false = wallet-first: socials are linked to a wallet you already have.
NEXT_PUBLIC_PRIVY_EMBEDDED_WALLETS=

# ── Verified profiles (ADR 0011). Optional: all three blank = profiles are off. ──────────────────
# These are SERVER secrets. Put them in web/.env.local or the host's environment, not in this root
# file: next.config.ts only reads NEXT_PUBLIC_* values from here, so they would be ignored.
#   PRIVY_APP_SECRET          Privy dashboard, your app's settings (next to the app id above)
#   UPSTASH_REDIS_REST_URL    Upstash console > your database > REST API
#   UPSTASH_REDIS_REST_TOKEN  (the Vercel Upstash integration sets KV_REST_API_URL / _TOKEN instead; both work)
PRIVY_APP_SECRET=
# Optional (ADR 0013): the signing secret (whsec_...) of the Privy webhook endpoint, which keeps shared
# profiles current when someone unlinks an account. Endpoint: https://<host>/api/webhooks/privy
# (Privy dashboard > Configuration > Webhooks). Production webhooks need Privy's Enterprise plan.
PRIVY_WEBHOOK_SIGNING_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional (ADR 0016): Clubs' app admins, as a comma-separated list of Privy user ids (did:privy:...,
# from the Privy dashboard > Users). An admin holds every role in every Club: they can assign or
# remove an Owner, ban someone from all Clubs, and purge a hidden Club. Leave blank for none.
CLUB_ADMIN_USER_IDS=
NEXT_PUBLIC_DEMO_TRADES=false
# Development-only preview of the wallet-gated Create Trade form.
NEXT_PUBLIC_DEMO_CREATE=false

# ── Intent pool and matcher (matcher/) ───────────────────────────────
# OnDealIntents, from script/DeployIntents.s.sol. Required by the matcher.
NEXT_PUBLIC_ON_DEAL_INTENTS_ADDRESS=
# The matcher's own funded TESTNET key. It pays settlement gas and holds no one's assets.
# Never put a key that holds real funds here.
MATCHER_PRIVATE_KEY=
# Web: the pool the intent screens talk to. Blank = http://127.0.0.1:8787 (the matcher's default).
NEXT_PUBLIC_POOL_URL=
# Optional. RPC falls back to NEXT_PUBLIC_RPC_URL.
MATCHER_RPC_URL=
MATCHER_HOST=127.0.0.1
MATCHER_PORT=8787
MATCHER_POLL_MS=5000
MATCHER_PRUNE_MS=30000
