# ── Contracts (Foundry) ──────────────────────────────────────────────
# Monad testnet (chain id 10143). RPC alias `monad_testnet` is set in contracts/foundry.toml.
# Deployer: prefer an encrypted keystore (`cast wallet import deployer --interactive`)
# over a raw key. Never commit a real key.

# DeployEscrow.s.sol: also deploy a mock ERC-20 (mUSD) and mint DEMO_MINT_AMOUNT of it to DEMO_WALLETS.
DEPLOY_MOCK_ERC20=false
DEMO_MINT_AMOUNT=1000

# Protocol fee (docs/adr/0015-protocol-fee.md, docs/adr/0018-adjustable-protocol-fee.md). The app reads
# it from the contract. PROTOCOL_FEE_WEI is the starting per-side fee in wei (0 = no fee). It is MON in
# DeClubEscrow (DeployEscrow) and WMON, the same amount, in DeClubIntents (DeployIntents).
# PROTOCOL_FEE_MAX_WEI is the ceiling the fee can never exceed, fixed at deploy (at most 500 MON);
# required whenever PROTOCOL_FEE_WEI isn't 0. FEE_ADMIN may change the fee within the ceiling: a cut
# applies at once, a raise after 7 days. Use a Safe apart from the recipient. It is required when the
# ceiling isn't 0, unless FEE_FIXED=true, which deploys with no admin so the fee never changes.
# The intents script wraps and unwraps 1 wei of FEE_TOKEN in its local simulation and refuses a
# token that doesn't behave like WMON.
# FEE_RECIPIENT receives the fee and is required when the ceiling is not 0: a Safe or another wallet
# that can receive MON and WMON. FEE_TOKEN is the chain's wrapped MON (DeployIntents only);
# DEPLOY_MOCK_WMON=true deploys a test WMON instead, for testnet, which has no canonical one.
PROTOCOL_FEE_WEI=0
PROTOCOL_FEE_MAX_WEI=
FEE_RECIPIENT=
FEE_ADMIN=
FEE_FIXED=false
FEE_TOKEN=
DEPLOY_MOCK_WMON=false

# Chog collection. Blank = the deploy script deploys MockChog.
CHOG_ADDRESS=
# MockChog only: comma-separated wallets to mint demo Chogs to, and how many each.
DEMO_WALLETS=
DEMO_MINT_PER_WALLET=5
DEPLOY_CHOG_MIRROR=false
MIRROR_CATALOG_OWNER=
MIRROR_MINT_BATCH=20

# ── Web (Next.js) ────────────────────────────────────────────────────
# web/next.config.ts loads the NEXT_PUBLIC_* keys of this root .env. Only the chain id, the RPC and
# the Chog collection have defaults (web/lib/config.ts); the deal contracts have none.
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# Blank = MockChog 0x220a2C52FD27252e7Cd6163A7bF1b6ae159D26e4, the original testnet demo collection.
NEXT_PUBLIC_CHOG_ADDRESS=
# DeClubEscrow, the deal contract (any ERC-721, ERC-20 and MON). Blank = no deals, outside the mock
# deals of development.
NEXT_PUBLIC_DECLUB_ESCROW_ADDRESS=
# Test ERC-20 with an open mint (deploy with DEPLOY_MOCK_ERC20=true). Optional.
NEXT_PUBLIC_MOCK_ERC20_ADDRESS=
# Unused: web/lib/config.ts still reads it, but nothing consumes it since the MockChog mint panel
# was removed. Safe to leave or delete.
NEXT_PUBLIC_CHOG_MINTABLE=true
# Optional. NFT collections the picker lists first, besides the Chog one (comma-separated addresses).
NEXT_PUBLIC_KNOWN_COLLECTIONS=
# Path gateway for ipfs:// token URIs and images, ending in /ipfs/. Blank = https://ipfs.io/ipfs/,
# which stalls on some collections (Chog Genesis); https://ipfs.filebase.io/ipfs/ serves them.
NEXT_PUBLIC_IPFS_GATEWAY=

# ── Demo world (web/scripts/demo.ts, docs/12-demo.md) ────────────────────────
# The three mainnet mirrors from contracts/script/DeployMirrors.s.sol, and the presenter's wallet.
DEMO_CHOG_ADDRESS=
DEMO_SKRUMPEYS_ADDRESS=
DEMO_R3TARDS_ADDRESS=
DEMO_PRESENTER_WALLET=
# Privy app id (dashboard.privy.io): Google / X / Discord / wallet sign-in and linked accounts
# (embedded wallets only with the flag below). Blank = the plain injected-wallet connect. Allow-list your origin in the dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
# true = social sign-in also creates an embedded wallet. Needs embedded wallets enabled in the Privy
# dashboard. Blank/false = wallet-first: socials are linked to a wallet you already have.
NEXT_PUBLIC_PRIVY_EMBEDDED_WALLETS=

# ── Verified profiles (ADR 0011). Optional: all three blank = profiles are off. ──────────────────
# These and the other non-NEXT_PUBLIC_ keys below (CRON_SECRET, FILL_WATCHER_START_BLOCK,
# CLUB_ADMIN_USER_IDS) are SERVER values. Put them in web/.env.local or the host's environment, not in
# this root file: next.config.ts only reads NEXT_PUBLIC_* values from here, so they would be ignored.
#   PRIVY_APP_SECRET          Privy dashboard, your app's settings (next to the app id above)
#   UPSTASH_REDIS_REST_URL    Upstash console > your database > REST API
#   UPSTASH_REDIS_REST_TOKEN  (the Vercel Upstash integration sets KV_REST_API_URL / _TOKEN instead; both work)
PRIVY_APP_SECRET=
# Optional (ADR 0013): the signing secret (whsec_...) of the Privy webhook endpoint, which keeps shared
# profiles current when someone unlinks an account. Endpoint: https://<host>/api/webhooks/privy
# (Privy dashboard > Configuration > Webhooks). Production webhooks need Privy's Enterprise plan.
PRIVY_WEBHOOK_SIGNING_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional (ADR 0019): the fill watcher, which records fills and Club activity the app never saw.
# A scheduler calls GET https://<host>/api/cron/fills with "Authorization: Bearer <CRON_SECRET>" every
# minute or so (Vercel Cron sends that header itself). Blank = off. FILL_WATCHER_START_BLOCK is where
# the first run starts (the deploy block of the DeClubEscrow the app is configured with backfills everything:
# 67163690 for 0x7359…E1bB; change it after a redeploy); blank = the current head.
CRON_SECRET=
FILL_WATCHER_START_BLOCK=
# Optional (ADR 0016): Clubs' app admins, as a comma-separated list of Privy user ids (did:privy:...,
# from the Privy dashboard > Users). An admin holds every role in every Club: they can assign or
# remove an Owner, ban someone from all Clubs, and purge a hidden Club. Leave blank for none.
CLUB_ADMIN_USER_IDS=

# ── Club Rewards (ADR 0022) ──────────────────────────────────────────
# DeClubRewards, from script/DeployRewards.s.sol. Blank = the Rewards tab shows pools but no Claim.
NEXT_PUBLIC_DECLUB_REWARDS_ADDRESS=
# Epoch length in seconds (default a week) and when epoch 0 starts (unix seconds; default
# 2026-10-05 00:00 UTC). Shorten the epoch for a demo.
NEXT_PUBLIC_REWARDS_EPOCH_SECONDS=
NEXT_PUBLIC_REWARDS_GENESIS=
# Deploy: who publishes, revokes and sweeps epochs (a Safe on mainnet), how long a root waits before
# claims open (seconds; default a day, 0 for a demo) and how long claims stay open (default 90 days).
REWARDS_OPERATOR=
REWARDS_CLAIM_DELAY=
REWARDS_CLAIM_WINDOW=
# `npm run rewards:epoch -- --publish` (in web/) signs `publish` with this key: the operator's, on
# TESTNET only. On mainnet, build without --publish and publish from the Safe.
REWARDS_OPERATOR_KEY=
# Optional (ADR 0024): the X API bearer token for the Holder bonus's reach read (likes, reposts,
# quotes and replies of members' X posts), read by `npm run rewards:epoch` before each epoch is built.
# Pay per use, about $0.005 a post read. A SERVER value: put it in web/.env.local. Blank = X posts
# count by number only, and an X post deleted after it was shared still counts. Sharing X posts on
# the Board, linking a Club's X account and counting posts need no key (they use X's free oEmbed).
X_BEARER_TOKEN=
# Optional (ADR 0027): a Moralis API key for on-chain asset search in Create Deal: the wallet's tokens and
# NFT collections, and tokens by name. Moralis covers Monad MAINNET only; on testnet, or with this blank,
# the search checks the verified and featured assets against the chain instead. A SERVER value: put it
# in web/.env.local. Calls are cached for 30 seconds; a collections call costs 50 CUs.
MORALIS_API_KEY=

# ── Intent pool and matcher (matcher/) ───────────────────────────────
# DeClubIntents, from script/DeployIntents.s.sol. Required by the matcher.
NEXT_PUBLIC_DECLUB_INTENTS_ADDRESS=
# The matcher's own funded TESTNET key. It pays settlement gas and holds no one's assets.
# Never put a key that holds real funds here.
MATCHER_PRIVATE_KEY=
# Web: the pool the intent screens talk to. Blank = http://127.0.0.1:8787 (the matcher's default).
# Where the app is served, for the absolute links in a shared deal's preview card (og:image). Blank = the
# Vercel production host, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_POOL_URL=
# Optional. RPC falls back to NEXT_PUBLIC_RPC_URL.
MATCHER_RPC_URL=
MATCHER_HOST=127.0.0.1
MATCHER_PORT=8787
MATCHER_POLL_MS=5000
MATCHER_PRUNE_MS=30000
